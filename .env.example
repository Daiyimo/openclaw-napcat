# OpenClaw Gateway
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=your-secret-token-here
TZ=Asia/Shanghai

# 数据目录（NAS 路径按需修改）
NAPCAT_DATA_DIR=/volume1/docker/napcat
OPENCLAW_DATA_DIR=/volume1/docker/openclaw

# QQ Channel Config
QQ_HTTP_URL=http://napcat:3000
QQ_REVERSE_WS_PORT=3002
QQ_ACCESS_TOKEN=123456
QQ_ADMINS=12345678
QQ_SHARED_ADMINS=
QQ_REQUIRE_MENTION=true
QQ_ALLOWED_GROUPS=
QQ_BLOCKED_USERS=
QQ_SYSTEM_PROMPT=
QQ_HISTORY_LIMIT=5
QQ_MARKDOWN_MODE=passthrough
QQ_RATE_LIMIT_MS=1000
QQ_ANTI_RISK_MODE=false
