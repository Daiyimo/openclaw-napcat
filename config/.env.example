# OpenClaw QQ 插件 (openclaw-napcat) — Docker 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# ========== NapCat 连接配置（必填）==========

# NapCat HTTP API 地址（容器间通信使用服务名，单机部署示例：http://napcat:3000）
QQ_HTTP_URL=http://napcat:3000

# NapCat WebSocket 地址
# 正向模式：填 NapCat WS Server 地址，如 ws://napcat:3001
# 反向模式：留空（openclaw 作为 WS 服务端，NapCat 主动连入）
QQ_WS_URL=ws://napcat:3001

# 反向 WS 监听端口（反向模式专用，正向模式留空）
# 启用后 openclaw 容器需暴露此端口（docker-compose 中已预留 3002）
# QQ_REVERSE_WS_PORT=3002

# NapCat 访问令牌（与 NapCat 配置中 token 字段一致，未配置则留空）
# QQ_ACCESS_TOKEN=

# ========== 触发与权限（可选）==========

# 管理员 QQ 号（逗号分隔，拥有 /ping /status /logs /mute /kick 等指令权限）
# QQ_ADMINS=123456789,987654321

# 群聊是否需要 @机器人 才触发（true/false，默认 true）
QQ_REQUIRE_MENTION=true

# 群组白名单（逗号分隔的群号，留空则所有群均可触发）
# QQ_ALLOWED_GROUPS=88888888,99999999

# 用户黑名单（逗号分隔的 QQ 号）
# QQ_BLOCKED_USERS=

# 关键词触发（逗号分隔，无需 @机器人，消息含任一关键词即触发）
# QQ_KEYWORD_TRIGGERS=小助手,AI,机器人

# ========== AI 行为（可选）==========

# 自定义系统提示词（Bot 人设，如"你是一个可爱的猫娘助理"）
# QQ_SYSTEM_PROMPT=

# 携带历史消息条数（0 = 不携带，默认 5）
# QQ_HISTORY_LIMIT=5

# Markdown 处理模式：passthrough（直接发送，默认）/ strip（转纯文本）/ native（NapCat 原生渲染）
# QQ_MARKDOWN_MODE=passthrough

# ========== 风控与速率（可选）==========

# 消息发送间隔（毫秒，防止 QQ 风控，默认 1000）
# QQ_RATE_LIMIT_MS=1000

# 入站频控（毫秒，同一来源两次触发的最短间隔，0 = 不限制）
# QQ_INBOUND_RATE_LIMIT_MS=0

# 静默关键词（消息含这些词时静默丢弃，不触发 AI，逗号分隔）
# QQ_SILENT_KEYWORDS=

# 反 QQ 风控模式（对 URL 等进行字符替换）
# QQ_ANTI_RISK_MODE=false

# ========== OpenClaw 主框架（可选）==========

# OpenClaw 网关访问 Token（与 WebUI 登录密码一致）
OPENCLAW_GATEWAY_TOKEN=

# 时区
TZ=Asia/Shanghai
