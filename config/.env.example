# OpenClaw QQ 插件 (docker-adaptation) — 环境变量配置
# 复制此文件为 .env 并根据实际情况修改
#
# ⚠️ QQ_HTTP_URL 必须填写宿主机的局域网 IP，不能用 127.0.0.1
#    NapCat WS 客户端的 URL 也需要填写宿主机 IP，如 ws://192.168.1.100:3002

# ========== NapCat 连接配置（必填）==========

# NapCat HTTP API 地址（宿主机 IP:3000，不能是 127.0.0.1）
QQ_HTTP_URL=http://192.168.1.100:3000

# OpenClaw 反向 WS 监听端口（NapCat WS 客户端连入此端口）
QQ_REVERSE_WS_PORT=3002

# NapCat 访问令牌（与 NapCat 配置中 token 字段一致）
# QQ_ACCESS_TOKEN=

# ========== 权限与触发（可选）==========

# 管理员 QQ 号（逗号分隔，可使用 /ping /status /logs /mute /kick 等指令）
# QQ_ADMINS=123456789

# 群聊是否需要 @机器人 才触发（true/false，默认 true）
QQ_REQUIRE_MENTION=true

# 群组白名单（逗号分隔的群号，留空则所有群均可触发）
# QQ_ALLOWED_GROUPS=

# 用户黑名单（逗号分隔的 QQ 号）
# QQ_BLOCKED_USERS=

# 关键词触发（逗号分隔，无需 @机器人）
# QQ_KEYWORD_TRIGGERS=

# ========== AI 行为（可选）==========

# 自定义系统提示词
# QQ_SYSTEM_PROMPT=

# 携带历史消息条数（0 = 不携带，默认 5）
# QQ_HISTORY_LIMIT=5

# Markdown 处理模式：passthrough（默认）/ strip / native
# QQ_MARKDOWN_MODE=passthrough

# ========== 风控（可选）==========

# 消息发送间隔（毫秒，防止 QQ 风控，默认 1000）
# QQ_RATE_LIMIT_MS=1000

# 入站频控（毫秒，同一来源最短触发间隔，0 = 不限制）
# QQ_INBOUND_RATE_LIMIT_MS=0

# 静默关键词（含这些词时静默丢弃，逗号分隔）
# QQ_SILENT_KEYWORDS=

# 反 QQ 风控模式（对 URL 进行字符替换）
# QQ_ANTI_RISK_MODE=false

# ========== 旁观模式（可选）==========

# 开启旁观模式：AI 旁观所有群消息，有感触时主动插话（需配合 requireMention: true）
# QQ_PASSIVE_MODE_ENABLED=true

# 旁观模式冷却时间（毫秒）：AI 主动回复后的静默期，默认 10000（10 秒）
# QQ_PASSIVE_MODE_COOLDOWN_MS=15000

# 旁观模式人设（留空使用默认：话不多但有分量的成员）
# QQ_PASSIVE_MODE_SYSTEM_PROMPT=你是群里话不多但很有分量的成员，只在真正有感触时才简短开口。没有想说的，回复 [SILENT]。

# ========== OpenClaw 主框架（可选）==========

# OpenClaw 网关访问 Token
OPENCLAW_GATEWAY_TOKEN=

# 数据持久化目录
# OPENCLAW_DATA_DIR=/volume1/docker/openclaw

# 时区
TZ=Asia/Shanghai
