{
  "id": "qq",
  "channels": [
    "qq"
  ],
  "channelConfigs": {
    "qq": {
      "label": "QQ (NapCat)",
      "description": "QQ bot via NapCat WebSocket (OneBot v11)",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "wsUrl": { "type": "string" },
          "httpUrl": { "type": "string" },
          "reverseWsPort": { "type": "number" },
          "accessToken": { "type": "string" },
          "admins": { "type": "array", "items": { "type": "number" } },
          "requireMention": { "type": "boolean" },
          "systemPrompt": { "type": "string" },
          "enableDeduplication": { "type": "boolean" },
          "enableErrorNotify": { "type": "boolean" },
          "autoApproveRequests": { "type": "boolean" },
          "maxMessageLength": { "type": "number" },
          "formatMarkdown": { "type": "boolean" },
          "antiRiskMode": { "type": "boolean" },
          "allowedGroups": { "type": "array", "items": { "type": "number" } },
          "blockedUsers": { "type": "array", "items": { "type": "number" } },
          "historyLimit": { "type": "number" },
          "keywordTriggers": { "type": "array", "items": { "type": "string" } },
          "enableTTS": { "type": "boolean" },
          "enableGuilds": { "type": "boolean" },
          "rateLimitMs": { "type": "number" },
          "reactionEmoji": { "type": "string" },
          "enableReactions": { "type": "boolean" },
          "autoMarkRead": { "type": "boolean" },
          "aiVoiceId": { "type": "string" },
          "enableSTT": { "type": "boolean" },
          "markdownMode": { "type": "string" },
          "deliverDebounce": { "type": "object" },
          "enableUpdateCheck": { "type": "boolean" },
          "logBufferSize": { "type": "number" },
          "inboundRateLimitMs": { "type": "number" },
          "silentKeywords": { "type": "array", "items": { "type": "string" } },
          "ssrfProtection": {
            "type": "object",
            "properties": {
              "allowedDomains": { "type": "array", "items": { "type": "string" } },
              "allowHttp": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "wsUrl": {
        "type": "string",
        "description": "OneBot v11 WebSocket URL"
      },
      "httpUrl": {
        "type": "string",
        "description": "OneBot v11 HTTP API URL"
      },
      "reverseWsPort": {
        "type": "number",
        "description": "Reverse WebSocket port"
      },
      "accessToken": {
        "type": "string",
        "description": "Access token"
      },
      "admins": {
        "type": "array",
        "items": { "type": "number" },
        "description": "Admin QQ numbers"
      },
      "requireMention": {
        "type": "boolean",
        "description": "Require @mention to trigger"
      },
      "systemPrompt": {
        "type": "string",
        "description": "Custom system prompt"
      },
      "enableDeduplication": {
        "type": "boolean",
        "description": "Enable message deduplication"
      },
      "enableErrorNotify": {
        "type": "boolean",
        "description": "Enable error notifications"
      },
      "autoApproveRequests": {
        "type": "boolean",
        "description": "Auto approve friend/group requests"
      },
      "maxMessageLength": {
        "type": "number",
        "description": "Max message length"
      },
      "formatMarkdown": {
        "type": "boolean",
        "description": "Format markdown to plain text"
      },
      "antiRiskMode": {
        "type": "boolean",
        "description": "Enable anti-risk processing"
      },
      "allowedGroups": {
        "type": "array",
        "items": { "type": "number" },
        "description": "Allowed group IDs"
      },
      "blockedUsers": {
        "type": "array",
        "items": { "type": "number" },
        "description": "Blocked user IDs"
      },
      "historyLimit": {
        "type": "number",
        "description": "History message limit"
      },
      "keywordTriggers": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Keyword triggers"
      },
      "enableTTS": {
        "type": "boolean",
        "description": "Enable TTS"
      },
      "enableGuilds": {
        "type": "boolean",
        "description": "Enable QQ Guild support"
      },
      "rateLimitMs": {
        "type": "number",
        "description": "Rate limit in ms"
      },
      "reactionEmoji": {
        "type": "string",
        "description": "Reaction emoji ID"
      },
      "enableReactions": {
        "type": "boolean",
        "description": "Enable reactions feature (allow external action calls to add/remove emoji reactions)"
      },
      "autoMarkRead": {
        "type": "boolean",
        "description": "Auto mark messages as read"
      },
      "aiVoiceId": {
        "type": "string",
        "description": "NapCat AI voice ID"
      },
      "enableSTT": {
        "type": "boolean",
        "description": "Enable speech-to-text for voice messages"
      },
      "markdownMode": {
        "type": "string",
        "description": "Markdown handling mode: passthrough / strip / native"
      },
      "deliverDebounce": {
        "type": "object",
        "description": "Outbound message debounce config",
        "properties": {
          "enabled": { "type": "boolean" },
          "windowMs": { "type": "number" },
          "maxWaitMs": { "type": "number" },
          "separator": { "type": "string" }
        }
      },
      "enableUpdateCheck": {
        "type": "boolean",
        "description": "Check npm registry for updates on startup"
      },
      "logBufferSize": {
        "type": "number",
        "description": "Number of log lines retained for /logs command"
      },
      "inboundRateLimitMs": {
        "type": "number",
        "description": "Per-user/group inbound rate limit in ms (0 = disabled)"
      },
      "silentKeywords": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Messages containing any of these keywords are silently dropped"
      },
      "ssrfProtection": {
        "type": "object",
        "description": "SSRF protection: restrict which domains can be fetched when processing voice/image URLs",
        "properties": {
          "allowedDomains": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Allowed domain suffixes (e.g. qpic.cn, qcloud.com). Defaults to QQ/Tencent CDN domains if empty"
          },
          "allowHttp": {
            "type": "boolean",
            "description": "Allow HTTP URLs (not just HTTPS). Defaults to false"
          }
        }
      }
    }
  }
}
