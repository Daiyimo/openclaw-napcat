{
  "name": "@openclaw/qq",
  "version": "1.9.2",
  "type": "module",
  "description": "OpenClaw QQ channel plugin via OneBot v11",
  "main": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/",
    "skills/"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepublishOnly": "npm run build",
    "check:config": "node scripts/check-config-sync.cjs && node scripts/check-docker-env-parity.cjs",
    "pretest": "npm run check:config",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:install": "bash scripts/test-install-download.sh"
  },
  "openclaw": {
    "extensions": [
      "./dist/src/index.js"
    ]
  },
  "dependencies": {
    "@types/node": "^25.4.0",
    "@types/ws": "^8.18.1",
    "mpg123-decoder": "^1.0.3",
    "silk-wasm": "^3.7.1",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
