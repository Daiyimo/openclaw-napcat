{
  "name": "@openclaw/qq",
  "version": "1.6.0",
  "type": "module",
  "description": "OpenClaw QQ channel plugin via OneBot v11",
  "main": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/",
    "skills/"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "setupEntry": "./src/setup-entry.ts",
    "skills": [
      "skills/qq-napcat"
    ],
    "channel": {
      "id": "qq",
      "label": "QQ (NapCat)",
      "selectionLabel": "QQ via NapCat",
      "docsPath": "/channels/napcat",
      "blurb": "QQ bot via NapCat WebSocket (OneBot v11)",
      "order": 80,
      "aliases": [
        "napcat",
        "qq-napcat"
      ]
    }
  },
  "dependencies": {
    "mpg123-decoder": "^1.0.3",
    "silk-wasm": "^3.7.1",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
